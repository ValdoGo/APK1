# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# FIREBASE CONFIGURATION
# Preencha com as credenciais do seu projeto Firebase Console.
# Deixe comentado para usar o projeto Firebase padrao ja embutido no
# codigo (ver app/google-services.json) sem precisar configurar nada.
# FIREBASE_API_KEY=AIzaSyYourApiKeyHere
# FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
# FIREBASE_PROJECT_ID=your-app-id
# FIREBASE_STORAGE_BUCKET=your-app.appspot.com
# FIREBASE_MESSAGING_SENDER_ID=123456789012
# FIREBASE_APP_ID=1:123456789012:android:abcdef123456

